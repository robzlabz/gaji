# PostgreSQL lokal (sesuaikan user/password/port dengan docker-compose di root repo)
DATABASE_URL=postgres://gaji:gaji@localhost:5432/gaji

# Better Auth local development. Gunakan secret acak minimal 32 karakter.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Optional: override database for read-only MCP server
# GAJI_DATABASE_URL=postgres://gaji:gaji@localhost:5432/gaji

# Optional: MCP HTTP smoke test settings
# MCP_PORT=3000
# MCP_URL=http://localhost:3000/api/mcp
# MCP_KEY=your-mcp-api-key
